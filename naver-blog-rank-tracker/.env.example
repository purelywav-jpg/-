# Get these from https://developers.naver.com/apps -> 애플리케이션 등록 -> 검색 API 사용 설정
NAVER_CLIENT_ID=your_client_id_here
NAVER_CLIENT_SECRET=your_client_secret_here

# Optional: how many results deep to search for a match (default 100).
# Higher values mean more API calls per keyword check.
NAVER_TRACKER_MAX_RANK=100

# Optional: override the SQLite file location.
# NAVER_TRACKER_DB=/absolute/path/to/tracker.db
